## Custom Hooks Pattern

### Every page gets a corresponding hook

| Page | Hook |
|---|---|
| `pages/(tabs)/home/index.tsx` | `hooks/useHomePage.ts` |
| `pages/view-event/index.tsx` | `hooks/useViewEvent.ts` |
| `pages/login/index.tsx` | `hooks/useLogin.ts` |

### Hook File Template

```typescript
import { useCallback, useEffect, useMemo, useState } from 'react'
import { router } from 'expo-router'
import { useGraphQL } from '@/hooks/useGraphQL'
import useAuth from '@/hooks/auth/useAuth'
import { GET_DATA } from '@/queries/getData'
import { CREATE_ITEM } from '@/mutations/createItem'

export function usePageName(param?: string) {
  // 1. Other hooks
  const { user_id, userData } = useAuth()

  // 2. Local state (grouped by purpose)
  const [activeTab, setActiveTab] = useState('default')
  const [items, setItems] = useState([])

  // 3. GraphQL queries (imported from /queries)
  const { data: queryData, loading, error, executeQuery } = useGraphQL(GET_DATA)

  useEffect(() => {
    if (user_id) {
      executeQuery({ userId: user_id })
    }
  }, [user_id, executeQuery])

  // 4. GraphQL mutations (imported from /mutations)
  const { executeQuery: createItem } = useGraphQL(CREATE_ITEM)

  // 5. Computed values (useMemo)
  const filteredItems = useMemo(() => {
    if (!items) return []
    return items.filter((item) => item.active)
  }, [items])

  // 6. Effects
  useEffect(() => {
    // Side effects grouped by concern
  }, [dependencies])

  // 7. Handlers (ALL wrapped in useCallback, ALL prefixed with "handle")
  const handleCreateItem = useCallback(async (name: string) => {
    try {
      const result = await createItem({ name })
      if (result) setItems((prev) => [...prev, result])
    } catch (err) {
      console.error('Error creating item:', err)
    }
  }, [createItem])

  const handleNavigate = useCallback((id: string) => {
    router.push(`/detail?id=${id}`)
  }, [])

  // 8. Return FLAT object (no nesting)
  return {
    // Data
    items: filteredItems,
    userData,
    // Loading/error
    loading,
    error,
    // UI state
    activeTab,
    // Setters (only if component needs direct control)
    setActiveTab,
    // Handlers
    handleCreateItem,
    handleNavigate,
  }
}

export default usePageName
```

### Hook Internal Order

1. Other hooks (`useAuth`, `useTheme`, etc.)
2. Local state (`useState`)
3. GraphQL queries (imported from `/queries`)
4. GraphQL mutations (imported from `/mutations`)
5. Computed values (`useMemo`)
6. Effects (`useEffect`)
7. Handlers (`useCallback`)
8. Return object (flat)

### CRITICAL: Flat Return Objects

```typescript
// WRONG — nested
return {
  data: { users, posts },
  loading: { usersLoading, postsLoading },
  handlers: { handleClick }
}

// CORRECT — flat
return {
  users,
  posts,
  usersLoading,
  postsLoading,
  handleClick,
}
```

