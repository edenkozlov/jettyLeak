VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GRAPHQL_ENDPOINT=https://your-hasura-instance.hasura.app/v1/graphql
# Local dev only — bypass browser CORS to Hasura (see vite.config.ts proxy).
# Example: VITE_GRAPHQL_ENDPOINT=http://localhost:5173/v1/graphql
#          VITE_GRAPHQL_DEV_PROXY_TARGET=https://your-hasura-instance.hasura.app
VITE_GRAPHQL_DEV_PROXY_TARGET=
VITE_HASURA_ADMIN_SECRET=your-hasura-admin-secret
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
VITE_BLE_WIFI_SERVICE_UUID=aksjdfjasdlfjajalsdjfsad
VITE_BLE_WIFI_SSID_CHAR_UUID=aksjdfjasdlfjajalsdjfsa
VITE_BLE_WIFI_PASS_CHAR_UUID=aksjdfjasdlfjajalsdjfsa
VITE_BLE_WIFI_STATUS_CHAR_UUID=aksjdfjasdlfjajalsdjfsa
VITE_BLE_WIFI_COMMAND_CHAR_UUID=aksjdfjasdlfjajalsdjfsa

# Jetty demo (Routine → Runbook → sensor-state)
JETTY_API_TOKEN=mlc_your_token
JETTY_COLLECTION=myorg123
JETTY_TASK=hourly-water-report
JETTY_ROUTINE=hourly-check
VITE_JETTY_SENSOR_ID=1
VITE_JETTY_COLLECTION=myorg123
VITE_JETTY_TASK=hourly-water-report
# Deploy sensor-state edge fn, then set in Jetty collection secrets:
SENSOR_ENDPOINT=https://your-project.supabase.co/functions/v1/sensor-state?sensor_id=1
# Push runbook/WATER_ANOMALY.md to GitHub, then:
RUNBOOK_URL=https://raw.githubusercontent.com/YOUR_USER/YOUR_REPO/main/runbook/WATER_ANOMALY.md